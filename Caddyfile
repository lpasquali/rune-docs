{
	admin off
	auto_https off
	servers {
		metrics
	}
}

:80 {
	root * /usr/share/caddy
	encode gzip zstd

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	try_files {path} {path}/ /index.html
	file_server
}
